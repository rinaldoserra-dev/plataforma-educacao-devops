    {"title": "CPU utilizada", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}, "targets": [{"expr": "rate(process_cpu_seconds_total[5m])", "legendFormat": "{{job}}"}]},
    {"title": "Health checks / disponibilidade", "type": "timeseries", "gridPos": {"h": 6, "w": 24, "x": 0, "y": 24}, "targets": [{"expr": "up", "legendFormat": "{{job}}"}]}
